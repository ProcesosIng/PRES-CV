# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# Base de datos corporativa (Solo lectura de maestros)
ODOO_DB_USER=
ODOO_DB_HOST=
ODOO_DB_NAME=
ODOO_DB_PASSWORD=
ODOO_DB_PORT=5432

# Base de datos propia (Lectura y Escritura del proyecto)
DB_LOCAL_HOST=
DB_LOCAL_USER=
DB_LOCAL_PASSWORD=
DB_LOCAL_NAME=
DB_LOCAL_PORT=5433

PORT=5000

# Dominios del frontend que pueden llamar a la API, separados por comas (en producción, el de Render).
# Vacío = se permite cualquiera (solo para desarrollo).
CORS_ORIGIN=

# ---------------------------------------------------------------------
# SEGURIDAD / LOGIN CON MICROSOFT (ver docs/SEGURIDAD_Y_DESPLIEGUE.md)
# ---------------------------------------------------------------------
# Datos del registro de la aplicación en Microsoft Entra ID (portal.azure.com → App registrations).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Clave para firmar las sesiones: texto aleatorio de 32+ caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_JWT_SECRET=

# Correos que siempre entran como administradores (separados por comas). Sirve para el primer ingreso.
ADMIN_EMAILS=

# Duración máxima de una sesión (horas) y cierre por inactividad (minutos).
SESION_HORAS=10
INACTIVIDAD_MINUTOS=60

# SOLO en tu PC: 'desarrollo' permite entrar escribiendo el correo, sin Microsoft.
# En Render/producción déjelo vacío y ponga NODE_ENV=production (ahí nunca se activa).
AUTH_MODO=
NODE_ENV=
